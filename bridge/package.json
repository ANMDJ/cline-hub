{
  "name": "cline-bridge",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Windows bridge: collect Cline session results and relay them to Cline Hub",
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "once": "node src/index.js --once",
    "health": "node -e \"fetch('http://127.0.0.1:3210/health').then(r=>r.text()).then(console.log)\"",
    "check:whitelist": "node scripts/check-workspace-whitelist.mjs",
    "test": "node --test"
  }
}
