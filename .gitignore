# 本地配置与运行态（含 token，绝不入库）
bridge/config.json
bridge/state.json
bridge/state.local-backup.json
bridge/outbox.json
bridge/logs/

# 部署期密钥（设备/手机 token、私钥）
.secrets/
*.pem

# 服务端
server/.env
server/node_modules/
server/dist/
server/logs/
server/*.out

# 通用
node_modules/
*.log
.DS_Store
.idea/

# 发版产物（APK / latest.json 由 scripts/release-apk.mjs 生成）
app/dist/
server/releases/

# 崩溃转储 / 本地备份（config.json 备份里有明文 token，绝不能进仓库）
*.stackdump
bash.exe.stackdump
*.bak-*
config.json.bak*
gradle-daemon-jvm.properties
