{
	# Caddy v2 — 放在 /etc/caddy/Caddyfile
	# 三个子域已解析到 82.157.153.22；80/443 必须在腾讯云「防火墙」里放行
	# 才能签证书（HTTP-01 / TLS-ALPN 都要过 80 或 443）。
	email admin@littlewish.top
	admin off
}

# ── Cline Hub：REST + SSE ────────────────────────────────────────────────
hub.littlewish.top {
	encode zstd gzip

	# SSE 必须实时下发：关掉反代缓冲，否则事件会被攒着发
	@events path /api/v1/events*
	reverse_proxy @events 127.0.0.1:3100 {
		flush_interval -1
	}

	reverse_proxy 127.0.0.1:3100 {
		transport http {
			read_timeout 0
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	log {
		output file /var/log/caddy/hub.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# ── ntfy：自建推送（可选，M0 现在直连 ntfy.sh）──────────────────────────
ntfy.littlewish.top {
	reverse_proxy 127.0.0.1:2586
	log {
		output file /var/log/caddy/ntfy.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}

# ── kids_points：Flutter Web 静态 + /api 反代（已有，占位保留）──────────
kids.littlewish.top {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
	log {
		output file /var/log/caddy/kids.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
