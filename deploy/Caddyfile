# ── HTTPS 非标端口入口（2026-11-01 新增，绕开 80/443 的未备案拦截）─────────
# 背景：https://hub.littlewish.top（443）TLS 握手被腾讯云按 SNI 重置，
#       http（80）被 302 到备案拦截页；但按 IP 或非标端口不触发拦截规则。
# 做法：复用 Caddy 已签发的 Let's Encrypt 证书（hub.littlewish.top，到期 2027-01-29，
#       存在 /var/lib/caddy/.local/share/caddy/certificates/...），只在 :8443 上再开一个站点。
# 客户端把 hubUrl 换成 https://hub.littlewish.top:8443 即可；token 不再明文暴露。
# 前置条件：腾讯云防火墙必须放行 TCP 8443（控制台 → 防火墙 / 安全组）。
# 证书续期提醒：Caddy 默认走 HTTP-01（80 端口被劫持）/ TLS-ALPN（443 被重置），
#       到期前需改 DNS-01（DNSPod API，需重编译 Caddy 带 dns 插件），或手动签发后
#       用 `tls <crt> <key>` 固定。到期日 2027-01-29。
hub.littlewish.top:8443 {
	encode zstd gzip

	# App 自更新：APK 是静态文件，必须抢在 catch-all 反代之前。
	# handle_path 会剥掉 /app 前缀，所以 root 指到 /var/www/cline-hub/app，
	# 即 /app/cline-console-1.1.0.apk -> /var/www/cline-hub/app/cline-console-1.1.0.apk。
	# 50MB 的包不该过 Node 进程。
	handle_path /app/* {
		root * /var/www/cline-hub/app
		file_server
	}

	# SSE 必须实时下发：关掉反代缓冲（与 443 站点一致）
	@events path /api/v1/events*
	reverse_proxy @events 127.0.0.1:3100 {
		flush_interval -1
	}

	reverse_proxy 127.0.0.1:3100 {
		transport http {
			read_timeout 0
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	log {
		output file /var/lib/caddy/hub-https.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
