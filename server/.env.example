# ---- 数据库 ----
# 本地开发：cline_hub 库由 cline_hub_app 拥有
# 生产（服务器）：见 docs/server-prep.md，应用角色 cline_hub_app 无 DDL
HUB_DATABASE_URL="postgresql://cline_hub_app:CHANGE_ME@127.0.0.1:5432/cline_hub"

# ---- 服务 ----
HUB_HOST=0.0.0.0
HUB_PORT=3100

# ---- 管理员令牌（创建设备 / 查看客户端用，长度 >= 32）----
HUB_ADMIN_TOKEN="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# ---- 启动时自动建表（生产建议 0，改为部署时 `npm run migrate`）----
HUB_AUTO_MIGRATE=1

# ---- 其他 ----
HUB_LOG_LEVEL=info
HUB_CORS_ORIGIN=*
HUB_MAX_BODY_BYTES=4194304
