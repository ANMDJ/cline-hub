# ---- 数据库 ----
# 本地开发：cline_hub 库由 cline_hub_app 拥有
# 生产（服务器）：见 docs/server-prep.md，应用角色 cline_hub_app 无 DDL
HUB_DATABASE_URL="postgresql://cline_hub_app:CHANGE_ME@127.0.0.1:5432/cline_hub"

# ---- 服务 ----
HUB_HOST=0.0.0.0
HUB_PORT=3100

# ---- 管理员令牌（创建设备 / 查看客户端用，长度 >= 32）----
HUB_ADMIN_TOKEN="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# ---- 启动时自动建表（生产建议 0，改为部署时 `npm run migrate`）----
HUB_AUTO_MIGRATE=1

# ---- 其他 ----
HUB_LOG_LEVEL=info
HUB_CORS_ORIGIN=*
HUB_MAX_BODY_BYTES=4194304

# ---- 兜底防护（备案期间走 HTTP 前缀入口时尤其要开着）----
# 每 IP 令牌桶：允许 120 个瞬时请求，之后每秒恢复 5 个
HUB_RATE_LIMIT_PER_SEC=5
HUB_RATE_LIMIT_BURST=120
# 可选 CIDR 白名单（逗号分隔，例如 "111.196.0.0/16,10.0.0.0/8"）。
# 留空 = 不限 IP（手机流量 IP 会变，通常留空）；本机回环永远放行。
HUB_ALLOW_IPS=

# ---- 命令租约（P42）----
# bridge 认领后必须在这个时间内续租（POST /commands/:id/heartbeat），
# 否则 Hub 把 delivered / running 收成 failed: orphaned（cancelling 收成 cancelled）。
# 默认 120 秒；bridge 侧每 30 秒续一次（bridge/config.json 的 commands.leaseHeartbeatMs）。
HUB_COMMAND_LEASE_SEC=120
# 扫描间隔（秒）：默认 60，所以「bridge 硬崩」最迟约 3 分钟自动收尾。
HUB_COMMAND_LEASE_SWEEP_SEC=60

# ---- DeepSeek 余额（P44，可选）----
# App 里的「DeepSeek 余额」由 Hub 代查：Key 只存在这一处，不会进 APK / 手机存储。
# 留空 = `/api/v1/deepseek/balance` 返回 `configured:false`，App 显示「Hub 未配置」。
# 取值：DeepSeek 开放平台 → API keys（https://platform.deepseek.com/api_keys）
DEEPSEEK_API_KEY=
# 上游地址（一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 余额短缓存秒数 + 上游超时毫秒（60 秒内重复刷新不会重复打 DeepSeek）
DEEPSEEK_BALANCE_TTL_SEC=60
DEEPSEEK_TIMEOUT_MS=8000
